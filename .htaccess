# Repo root as deployed (public_html/live): only public/ is web-served.
Options -Indexes
RewriteEngine On
RewriteRule ^(app|bin|content|db|docs|legacy|storage|tests)(/|$) - [F,L]
# Dot-paths are never served, except /.well-known/ (certificate renewal, HTTP-01).
RewriteRule ^(?!\.well-known/)(.*/)?\. - [F,L]
RewriteRule ^(?!public/)(.*)$ public/$1 [L]
