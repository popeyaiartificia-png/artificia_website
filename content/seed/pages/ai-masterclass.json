      "type": "process_steps",
      "fields": {
        "variant": "course-projects",
        "heading": "Real AI skills.\n*Real projects.*",
        "intro": "Build websites, create content and automate everyday work in our 60-day AI Masterclass.",
        "cta_label": "Explore the 60-day curriculum",
        "cta_link": "#curriculum",
        "steps": [
          {
            "title": "Your website. Live.",
            "text": "Turn an idea into a responsive website and publish it online.",
            "visual": "website",
            "tools": "Lovable / Antigravity / Vercel",
            "day_range": "Days 18–26"
          },
          {
            "title": "Your AI content kit.",
            "text": "Create presentations, visuals and short videos for a real brief.",
            "visual": "content",
            "tools": "Gamma / Canva / Runway",
            "day_range": "Days 11–16"
          },
          {
            "title": "An assistant for your documents.",
            "text": "Build an AI assistant that finds answers in your own files.",
            "visual": "assistant",
            "tools": "Pinecone / LangChain / Gemini API",
            "day_range": "Days 45–46"
          },
          {
            "title": "A workflow that does the work.",
            "text": "Connect forms, AI and Google Sheets in one working automation.",
            "visual": "automation",
            "tools": "n8n / Google Sheets / OpenAI API",
            "day_range": "Days 36–39"
          }
        ]
      }
    },
    {
      "type": "curriculum",
      "fields": {
        "variant": "course",
        "heading": "A little every day.\n*A lot by day sixty.*",
        "intro": "The 30-day Foundation covers days 1–30. The 60-day Full program includes the Foundation and continues into agents, automation and deployment. Ask us for the day-by-day plan and we will walk you through it.",
        "modules": [
          {
            "track": "foundation",
            "day_range": "1–3",
            "title": "AI foundations & better prompts",
            "topics": "Understand AI, compare models and learn prompt frameworks, advanced prompting, custom instructions and reusable prompts.",
            "tools": "ChatGPT · Claude · Gemini · DeepSeek"
          },
          {
            "track": "foundation",
            "day_range": "4–7",
            "title": "Machine learning, office work & research",
            "topics": "Explore machine learning with everyday examples. Use AI for documents, spreadsheets, meetings and research, with source checking and responsible use.",
            "tools": "Teachable Machine · Copilot · Perplexity · NotebookLM"
          },
          {
            "track": "foundation",
            "day_range": "8–10",
            "title": "Know your AI assistants",
            "topics": "Go deeper into ChatGPT, Gemini and Claude: custom assistants, workspace tools, document analysis, Projects and Artifacts.",
            "tools": "ChatGPT · Gemini · Claude"
          },
          {
            "track": "foundation",
            "day_range": "11–17",
            "title": "Create with AI. Make sense of data.",
            "topics": "Create presentations, images, video, voiceovers and avatar videos. Work with Canva, then clean data, create charts and build useful reports.",
            "tools": "Gamma · Canva · Runway · ElevenLabs · HeyGen · Excel"
          },
          {
            "track": "foundation",
            "day_range": "18–22",
            "title": "Websites, design & connected tools",
            "topics": "Build a website from a prompt, learn UI design, test prompts in AI Studio, understand Git and use Google Sheets as a simple backend.",
            "tools": "Lovable · Bolt.new · Figma · Google AI Studio · GitHub · Google Sheets"
          },
          {
            "track": "foundation",
            "day_range": "23–30",
            "title": "Build, ship & show your first project",
            "topics": "Move into an AI coding editor, work across files, connect integrations and deploy with GitHub and Vercel. Plan, build, test and present your project in a portfolio.",
            "tools": "Antigravity · GitHub · Vercel · Canva · Loom"
          },
          {
            "track": "full",
            "day_range": "31–35",
            "title": "AI agents, voice & backends",
            "topics": "Understand agent reasoning. Build and test voice agents, then connect databases, authentication and storage to a working frontend.",
            "tools": ""
          },
          {
            "track": "full",
            "day_range": "36–39",
            "title": "Automate real workflows with n8n",
            "topics": "Connect triggers, APIs and webhooks. Build lead workflows, WhatsApp and Telegram bots, sub-workflows and error handling.",
            "tools": ""
